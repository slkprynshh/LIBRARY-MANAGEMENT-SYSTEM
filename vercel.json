{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "library-frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "library-frontend/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "library-frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "library-frontend/js/$1"
    },
    {
      "src": "/",
      "dest": "library-frontend/index.html"
    },
    {
      "src": "/(.*).html",
      "dest": "library-frontend/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "library-frontend/$1"
    }
  ]
}
